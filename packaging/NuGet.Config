<?xml version="1.0" encoding="utf-8"?>
<!-- Release builds bundle the .NET runtime, so people don't have to install it. It comes from nuget.org as
     Microsoft's runtime packs, and source mapping lets nothing else through: the app itself uses no packages.
     ILLink.Tasks is the SDK's build-time single-file analyzer; it isn't shipped. -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="Microsoft.NETCore.App.Runtime.*" />
      <package pattern="Microsoft.WindowsDesktop.App.Runtime.*" />
      <package pattern="Microsoft.NETCore.App.Host.*" />
      <package pattern="Microsoft.NET.ILLink.Tasks" />
    </packageSource>
  </packageSourceMapping>
</configuration>
